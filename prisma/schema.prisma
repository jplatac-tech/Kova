generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String        @default("")
  price       Int
  badge       String?
  featured    Boolean       @default(false)
  isActive    Boolean       @default(true)
  images      String[]
  brandId     String
  brand       Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  sizes       ProductSize[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([brandId])
  @@index([isActive])
  @@index([featured])
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  label     String
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
}

model SiteSettings {
  id               String   @id @default("default")
  heroEyebrow      String   @default("")
  heroTitle        String   @default("")
  heroSubtitle     String   @default("")
  heroImage        String   @default("")
  catalogTitle     String   @default("")
  catalogSubtitle  String   @default("")
  footerText       String   @default("")
  whatsappNumber   String   @default("")
  updatedAt        DateTime @updatedAt
}

model AdminCredential {
  id           String   @id @default("default")
  email        String   @unique
  passwordSalt String
  passwordHash String
  updatedAt    DateTime @updatedAt
}
